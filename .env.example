# Supabase — powers the /resources content library + realtime interactions.
# Without these, the site falls back to local seed content and a demo
# interaction layer, so it still builds and runs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend — all transactional email plus the subscriber audience.
# The key needs FULL access, not "sending access" only: audience writes
# (Subscribe, Field Kit unlocks) fail with a sending-only key. Visit
# GET /api/subscribe in a browser for a plain-words diagnosis.
# Without a key, the forms report a configuration error rather than
# pretending to have subscribed anyone.
RESEND_API_KEY=

# Verified sender. Must be on a domain verified in Resend (the root domain is
# not verified; email.dareomotosho.com is). Defaults to
# "Dare Omotosho <results@email.dareomotosho.com>" if unset. Quotes and angle
# brackets are sanitised, because a mangled paste here is a 422 from Resend.
RESEND_FROM=

# Optional. Pins a specific audience; otherwise the first audience on the
# account is discovered automatically. A wrong value falls back to discovery
# rather than failing.
RESEND_AUDIENCE_ID=
